{
  "$schema": "https://raw.githubusercontent.com/francisdb/cuelight/main/crates/cuelight/schemas/show.schema.json",
  "format": 1, "name": "keys_and_presses", "size": [800, 450], "background": "#0E1116",
  "variables": {"shown": true, "phase": ""},
  "input": {"keys": {" ": "tap", "ArrowLeft": "left", "ArrowRight": "right", "Enter": "anywhere"}, "press": "anywhere"},
  "layers": [
    {
      "name": "title", "type": "digits", "digits": 16, "size": [139, 20], "x": 24, "y": 18, "text": "KEYS AND PRESSES",
      "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}
    },
    {
      "name": "legend", "type": "digits", "digits": 62, "size": [537, 12], "x": 24, "y": 50,
      "text": "SPACE TAPS. ARROWS LEFT AND RIGHT. ENTER OR A CLICK ELSEWHERE",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },

    {
      "name": "tap", "type": "group", "x": 24, "y": 84,
      "children": [
        {"name": "pad", "type": "shape", "shape": {"rect": [0, 0, 160, 90], "radius": 10}, "fill": "#232A34", "press": {"trigger": "tap"}},
        {
          "name": "hit", "type": "shape", "shape": {"rect": [0, 0, 160, 90], "radius": 10}, "fill": "#FFB000", "opacity": 0,
          "timelines": [{"name": "flash", "trigger": "tap", "tracks": [{"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.8, "v": 0, "ease": "quad_in"}]}]}]
        },
        {"name": "label", "type": "digits", "digits": 3, "size": [26, 14], "x": 67, "y": 38, "text": "TAP", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}}
      ]
    },
    {
      "name": "tap_caption", "type": "digits", "digits": 18, "size": [156, 12], "x": 26, "y": 184, "text": "A PRESS FIRES TAP",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },

    {
      "name": "moving", "type": "group", "x": 220, "y": 84,
      "timelines": [
        {"name": "slide", "autoplay": true, "loop": true,
         "tracks": [{"property": "x", "keys": [{"t": 0, "v": 220}, {"t": 1.5, "v": 360, "ease": "quad_in_out"}, {"t": 3, "v": 220, "ease": "quad_in_out"}]}]}
      ],
      "children": [
        {"name": "pad", "type": "shape", "shape": {"rect": [0, 0, 160, 90], "radius": 10}, "fill": "#232A34", "press": {"trigger": "moving"}},
        {
          "name": "hit", "type": "shape", "shape": {"rect": [0, 0, 160, 90], "radius": 10}, "fill": "#FFB000", "opacity": 0,
          "timelines": [{"name": "flash", "trigger": "moving", "tracks": [{"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.8, "v": 0, "ease": "quad_in"}]}]}]
        },
        {"name": "label", "type": "digits", "digits": 6, "size": [52, 14], "x": 54, "y": 38, "text": "MOVING", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}}
      ]
    },
    {
      "name": "moving_caption", "type": "digits", "digits": 20, "size": [174, 12], "x": 222, "y": 184, "text": "HIT WHERE IT IS NOW",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },

    {
      "name": "hidden", "type": "group", "x": 24, "y": 224,
      "children": [
        {"name": "frame", "type": "shape", "shape": {"rect": [0, 0, 160, 90], "radius": 10}, "fill": "#161B24"},
        {
          "name": "pad", "type": "shape", "shape": {"rect": [0, 0, 160, 90], "radius": 10}, "fill": "#232A34", "press": {"trigger": "hidden"},
          "bindings": [{"property": "visible", "variable": "shown"}]
        },
        {
          "name": "hit", "type": "shape", "shape": {"rect": [0, 0, 160, 90], "radius": 10}, "fill": "#FFB000", "opacity": 0,
          "timelines": [{"name": "flash", "trigger": "hidden", "tracks": [{"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.8, "v": 0, "ease": "quad_in"}]}]}]
        },
        {
          "name": "label", "type": "digits", "digits": 6, "size": [52, 14], "x": 54, "y": 38, "text": "", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}},
          "bindings": [{"property": "text", "variable": "shown", "map": {"true": "SHOWN", "false": "HIDDEN"}}]
        }
      ]
    },
    {
      "name": "hidden_caption", "type": "digits", "digits": 19, "size": [165, 12], "x": 26, "y": 324, "text": "HIDDEN: NOT PRESSED",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },

    {
      "name": "clipped", "type": "group", "x": 220, "y": 224, "clip": {"rect": [0, 0, 80, 90]},
      "children": [
        {"name": "pad", "type": "shape", "shape": {"rect": [0, 0, 160, 90], "radius": 10}, "fill": "#232A34", "press": {"trigger": "clipped"}},
        {
          "name": "hit", "type": "shape", "shape": {"rect": [0, 0, 160, 90], "radius": 10}, "fill": "#FFB000", "opacity": 0,
          "timelines": [{"name": "flash", "trigger": "clipped", "tracks": [{"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.8, "v": 0, "ease": "quad_in"}]}]}]
        },
        {"name": "label", "type": "digits", "digits": 4, "size": [35, 14], "x": 22, "y": 38, "text": "CLIP", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}}
      ]
    },
    {
      "name": "clipped_ghost", "type": "shape", "shape": {"rect": [80, 0, 80, 90], "radius": 10}, "x": 220, "y": 224, "fill": "#161B24"
    },
    {
      "name": "clipped_caption", "type": "digits", "digits": 26, "size": [225, 12], "x": 222, "y": 324, "text": "CLIPPED: WHAT SHOWS IS HIT",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },

    {
      "name": "keys", "type": "group", "x": 460, "y": 84,
      "children": [
        {"name": "heading", "type": "digits", "digits": 4, "size": [35, 14], "x": 0, "y": 0, "text": "KEYS", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}},
        {
          "name": "left_lamp", "type": "shape", "shape": {"circle": [0, 0, 22]}, "x": 30, "y": 60, "fill": "#38BDF8", "opacity": 0.08,
          "timelines": [{"name": "flash", "trigger": "left", "tracks": [{"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.8, "v": 0.08, "ease": "quad_in"}]}]}]
        },
        {"name": "left_label", "type": "digits", "digits": 4, "size": [35, 12], "x": 12, "y": 92, "text": "LEFT", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}},
        {
          "name": "space_lamp", "type": "shape", "shape": {"circle": [0, 0, 22]}, "x": 110, "y": 60, "fill": "#FFB000", "opacity": 0.08,
          "timelines": [{"name": "flash", "trigger": "tap", "tracks": [{"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.8, "v": 0.08, "ease": "quad_in"}]}]}]
        },
        {"name": "space_label", "type": "digits", "digits": 5, "size": [43, 12], "x": 88, "y": 92, "text": "SPACE", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}},
        {
          "name": "right_lamp", "type": "shape", "shape": {"circle": [0, 0, 22]}, "x": 190, "y": 60, "fill": "#38BDF8", "opacity": 0.08,
          "timelines": [{"name": "flash", "trigger": "right", "tracks": [{"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.8, "v": 0.08, "ease": "quad_in"}]}]}]
        },
        {"name": "right_label", "type": "digits", "digits": 5, "size": [43, 12], "x": 168, "y": 92, "text": "RIGHT", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}}
      ]
    },
    {
      "name": "keys_caption", "type": "digits", "digits": 38, "size": [330, 12], "x": 462, "y": 200, "text": "A KEY THE SHOW NAMES FIRES ITS TRIGGER",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },

    {
      "name": "anywhere", "type": "group", "x": 460, "y": 224,
      "children": [
        {"name": "heading", "type": "digits", "digits": 8, "size": [69, 14], "x": 0, "y": 0, "text": "ANYWHERE", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}},
        {
          "name": "lamp", "type": "shape", "shape": {"rect": [0, 0, 200, 40], "radius": 8}, "x": 0, "y": 30, "fill": "#4ADE80", "opacity": 0.08,
          "timelines": [{"name": "flash", "trigger": "anywhere", "tracks": [{"property": "opacity", "keys": [{"t": 0, "v": 0.9}, {"t": 0.8, "v": 0.08, "ease": "quad_in"}]}]}]
        },
        {
          "name": "link", "type": "group", "x": 210, "y": 30,
          "press": {"trigger": "link", "open": "https://francisdb.github.io/cuelight-examples/"},
          "children": [
            {
              "name": "pad", "type": "shape", "shape": {"rect": [0, 0, 90, 40], "radius": 8}, "fill": "#60A5FA", "opacity": 0.25,
              "timelines": [{"name": "flash", "trigger": "link", "tracks": [{"property": "opacity", "keys": [{"t": 0, "v": 0.9}, {"t": 0.8, "v": 0.25, "ease": "quad_in"}]}]}]
            },
            {"name": "label", "type": "digits", "digits": 4, "size": [35, 14], "x": 28, "y": 13, "text": "OPEN", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}}
          ]
        }
      ]
    },
    {
      "name": "anywhere_caption", "type": "digits", "digits": 38, "size": [330, 12], "x": 462, "y": 324, "text": "NOTHING OR ENTER  BLUE OPENS A PAGE",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },

    {
      "name": "note", "type": "digits", "digits": 78, "size": [676, 12], "x": 24, "y": 372,
      "text": "THE HOST HANDS OVER KEYS AND CLICKS. THE SHOW SAYS WHAT THEY MEAN AND WHERE.",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },
    {
      "name": "phase", "type": "digits", "digits": 60, "size": [520, 14], "x": 24, "y": 404, "text": "",
      "display": {"segments": {"style": "alpha14", "fill": "#FFB000"}},
      "bindings": [{"property": "text", "variable": "phase"}]
    }
  ]
}
