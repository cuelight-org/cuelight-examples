{
  "$schema": "https://raw.githubusercontent.com/cuelight-org/cuelight/main/crates/cuelight-core/schemas/show.schema.json",
  "format": 1, "name": "bound_video", "size": [640, 360], "background": "#0E1116",
  "variables": {"restart": "", "queue": "", "phase": ""},
  "layers": [
    {
      "name": "title", "type": "digits", "digits": 11, "size": [95, 20], "x": 16, "y": 14, "text": "BOUND VIDEO",
      "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}
    },
    {
      "name": "note", "type": "digits", "digits": 52, "size": [451, 12], "x": 16, "y": 42,
      "text": "THE CLIP A LAYER PLAYS FOLLOWS A VARIABLE: C, E OR G",
      "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}
    },

    {
      "name": "restart_row", "type": "group", "x": 16, "y": 70,
      "children": [
        {"name": "frame", "type": "shape", "shape": {"rect": [-2, -2, 196, 112], "radius": 4}, "fill": "#161B24"},
        {
          "name": "clip", "type": "video", "video": "pop_c", "gain": 0.6, "retrigger": "restart", "on_end": "restart_end",
          "bindings": [{"property": "video", "variable": "restart", "map": {"C": "pop_c", "E": "pop_e", "G": "pop_g"}}]
        },
        {
          "name": "asked", "type": "digits", "digits": 1, "size": [12, 16], "x": 210, "y": 10, "text": "",
          "display": {"segments": {"style": "alpha14", "fill": "#FFB000"}},
          "bindings": [{"property": "text", "variable": "restart"}]
        },
        {
          "name": "ended", "type": "shape", "shape": {"circle": [0, 0, 10]}, "x": 216, "y": 60, "fill": "#4ADE80", "opacity": 0.08,
          "timelines": [{"name": "flash", "trigger": "restart_end", "tracks": [{"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.6, "v": 0.08, "ease": "quad_in"}]}]}]
        },
        {"name": "ended_label", "type": "digits", "digits": 5, "size": [43, 10], "x": 195, "y": 78, "text": "ENDED", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}},
        {"name": "caption_1", "type": "digits", "digits": 7, "size": [61, 12], "x": 260, "y": 30, "text": "RESTART", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}},
        {"name": "caption_2", "type": "digits", "digits": 34, "size": [295, 12], "x": 260, "y": 50, "text": "A NEW CLIP CUTS THE ONE PLAYING", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}}
      ]
    },

    {
      "name": "queue_row", "type": "group", "x": 16, "y": 200,
      "children": [
        {"name": "frame", "type": "shape", "shape": {"rect": [-2, -2, 196, 112], "radius": 4}, "fill": "#161B24"},
        {
          "name": "clip", "type": "video", "video": "pop_c", "gain": 0.6, "retrigger": "queue", "on_end": "queue_end",
          "bindings": [{"property": "video", "variable": "queue", "map": {"C": "pop_c", "E": "pop_e", "G": "pop_g"}}]
        },
        {
          "name": "asked", "type": "digits", "digits": 1, "size": [12, 16], "x": 210, "y": 10, "text": "",
          "display": {"segments": {"style": "alpha14", "fill": "#FFB000"}},
          "bindings": [{"property": "text", "variable": "queue"}]
        },
        {
          "name": "ended", "type": "shape", "shape": {"circle": [0, 0, 10]}, "x": 216, "y": 60, "fill": "#4ADE80", "opacity": 0.08,
          "timelines": [{"name": "flash", "trigger": "queue_end", "tracks": [{"property": "opacity", "keys": [{"t": 0, "v": 1}, {"t": 0.6, "v": 0.08, "ease": "quad_in"}]}]}]
        },
        {"name": "ended_label", "type": "digits", "digits": 5, "size": [43, 10], "x": 195, "y": 78, "text": "ENDED", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}},
        {"name": "caption_1", "type": "digits", "digits": 5, "size": [43, 12], "x": 260, "y": 30, "text": "QUEUE", "display": {"segments": {"style": "alpha14", "fill": "#E6EDF3"}}},
        {"name": "caption_2", "type": "digits", "digits": 36, "size": [312, 12], "x": 260, "y": 50, "text": "EACH CLIP PLAYS TO ITS END, IN TURN", "display": {"segments": {"style": "alpha14", "fill": "#8B96A5"}}}
      ]
    },

    {
      "name": "phase", "type": "digits", "digits": 56, "size": [485, 14], "x": 16, "y": 330, "text": "",
      "display": {"segments": {"style": "alpha14", "fill": "#FFB000"}},
      "bindings": [{"property": "text", "variable": "phase"}]
    }
  ]
}
